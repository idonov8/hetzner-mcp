# One READ-ONLY token per Hetzner project, as comma-separated name:token pairs.
# Names: ^[a-z0-9_-]{1,32}$. Create each token in Console -> project -> Security -> API tokens.
HCLOUD_TOKENS=personal:,we4water:
# Secret path segment, at least 32 chars. Generate: openssl rand -hex 24
MCP_ACCESS_KEY=
# Optional: console project ids (number in the console URL) for console_url
HCLOUD_PROJECT_IDS=personal:,we4water:
# Legacy single-project fallback (used only if HCLOUD_TOKENS is unset; project name "default")
# HCLOUD_TOKEN=
# HCLOUD_PROJECT_ID=
