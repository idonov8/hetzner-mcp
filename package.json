{
  "name": "hetzner-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only remote MCP server for the Hetzner Cloud API (Vercel / Next.js)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
